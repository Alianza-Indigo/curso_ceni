# Copia este archivo a .env y completa los valores reales antes de correr
# `npm run dev`, `npm run build` o desplegar a producción.

# --- Base de datos (PostgreSQL) ---
# Cualquier proveedor sirve: Vercel Postgres, Neon, Supabase, Railway, RDS, etc.
DATABASE_URL="postgresql://usuario:password@host:5432/nombre_db"

# --- Auth.js / NextAuth ---
# Genera un valor aleatorio con: openssl rand -base64 32
AUTH_SECRET=""
# Necesario si Auth.js no puede inferir el host correctamente detrás de un proxy/CDN.
AUTH_TRUST_HOST="true"

# --- Google OAuth ---
# Crear en https://console.cloud.google.com/apis/credentials
# Tipo: "Aplicación web".
# Orígenes autorizados de JavaScript: https://tu-dominio.com
# URI de redirección autorizada: https://tu-dominio.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Asistente virtual (Gemini) ---
# Crea una API key en https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# --- Invitaciones de organizaciones (integración con ceni_vercel) ---
# Genera un valor aleatorio largo (openssl rand -base64 32) y compártelo de
# forma segura con ceni_vercel: ahí se configura como CURSO_API_KEY. Nunca lo
# expongas al cliente.
PARTNER_API_KEY=""

# --- Envío de correo de invitación (Resend) ---
# Crea una API key en https://resend.com/api-keys
RESEND_API_KEY=""
# Remitente verificado en Resend (requiere dominio verificado en alianzaindigo.org).
RESEND_FROM_EMAIL="Curso CENI <curso@alianzaindigo.org>"

# --- Panel de administración (/admin) ---
# No requiere variables de entorno: el usuario admin vive en la tabla
# AdminUsuario (Postgres), sembrado por la migración
# prisma/migrations/20260731040600_admin_usuario. La contraseña se cambia
# desde el propio panel (/admin → "Cambiar contraseña"), no aquí.

# Correos (separados por coma) con avance libre en el curso: pueden navegar
# todos los módulos y presentar el examen sin el bloqueo secuencial. Las cuentas
# registradas en el panel de administración (AdminUsuario) también avanzan libre.
CURSO_ADMIN_EMAILS=
