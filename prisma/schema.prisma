generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts          Account[]
  sessions          Session[]
  progresoModulos   ProgresoModulo[]
  resultadosExamen  ResultadoExamen[]
  entregasActividad EntregaActividad[]
  entregasFinal     EntregaFinal[]

  // Tope diario de mensajes al asistente virtual (protección de costo).
  asistenteMensajesHoy Int       @default(0)
  asistenteMensajesDia DateTime?

  // Organización (empresa) externa a la que pertenece este alumno, si fue
  // invitado desde ceni_vercel. Es un ID opaco: la organización vive en otra
  // base de datos, así que esto NO es un foreign key real.
  organizacionId String?

  // Login por contraseña (además de Google), usado por empleados invitados.
  // Null = este usuario solo entra con Google. La contraseña solo se crea
  // dentro del flujo de aceptación de invitación (/invitacion/[token]).
  passwordHash             String?
  passwordIntentosFallidos Int       @default(0)
  passwordBloqueadoHasta   DateTime?

  invitacionesAceptadas Invitacion[]

  createdAt DateTime @default(now())

  @@index([organizacionId])
}

enum EstadoInvitacion {
  PENDIENTE
  ACEPTADA
  EXPIRADA
}

// Invitación de una organización externa (ceni_vercel) para que un empleado
// tome el curso. `organizacionId` es un ID opaco de Organization en el otro
// sistema — no hay FK real porque viven en bases de datos distintas.
model Invitacion {
  id             String           @id @default(cuid())
  email          String
  organizacionId String
  // Generado con crypto.randomBytes(32), no cuid(): es un secreto de un solo
  // uso, no un identificador interno.
  token          String           @unique
  estado         EstadoInvitacion @default(PENDIENTE)
  expiresAt      DateTime
  // Identificador opaco de quién invitó del lado de ceni_vercel; no es FK.
  invitadoPor    String?
  createdAt      DateTime         @default(now())

  // Se llena al aceptar, para auditar qué User completó cuál invitación.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, estado])
  @@index([organizacionId, estado])
  @@index([organizacionId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Resultado del quiz de un módulo para un usuario autenticado.
model ProgresoModulo {
  id         String   @id @default(cuid())
  userId     String
  moduloId   String
  respuestas Json
  aciertos   Int
  total      Int
  porcentaje Int
  aprobado   Boolean
  fecha      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduloId])
}

// Resultado del examen integrador final. Un registro por usuario (se sobrescribe en cada intento).
// `aprobado` representa la certificación COMPLETA (examen 40% + caso práctico 40% +
// retroalimentación 20%, según componentesEvaluacionFinal), no solo el examen de opción
// múltiple — ver recalcularCertificacionFinal() en lib/progreso-server.ts.
model ResultadoExamen {
  id                 String    @id @default(cuid())
  userId             String
  // Curso al que pertenece este examen final ("ceni", "diplomado", ...).
  cursoId            String    @default("ceni")
  respuestas         Json
  aciertos           Int
  total              Int
  porcentaje         Int
  aprobado           Boolean
  fecha              DateTime  @default(now())
  folio              String?   @unique
  // Momento en que se completaron los tres componentes de la evaluación final.
  fechaCertificacion DateTime?
  // Vigencia de 1 año desde fechaCertificacion, como especifica el curso original.
  vigenciaHasta      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cursoId])
}

// Caso práctico aplicado y retroalimentación del curso — los otros dos componentes
// de la evaluación final (40% y 20% respectivamente) además del examen de opción
// múltiple. Un registro por usuario; se sobrescribe con cada guardado.
model EntregaFinal {
  id                String   @id @default(cuid())
  userId            String
  // Curso al que pertenece esta entrega final ("ceni", "diplomado", ...).
  cursoId           String   @default("ceni")
  casoPractico      String?  @db.Text
  retroalimentacion String?  @db.Text
  actualizadoEn     DateTime @updatedAt
  creadoEn          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cursoId])
}

// Entregable escrito de una actividad práctica de un módulo. El curso original
// pondera estas actividades como la mayor parte de la calificación de cada
// módulo (los quizzes son 25-45%); un módulo solo cuenta como completo cuando
// el quiz está aprobado Y todas sus actividades tienen entrega.
model EntregaActividad {
  id              String   @id @default(cuid())
  userId          String
  moduloId        String
  actividadCodigo String
  contenido       String   @db.Text
  actualizadoEn   DateTime @updatedAt
  creadoEn        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduloId, actividadCodigo])
}

// Credenciales del panel de administración. Login propio (no Google OAuth).
// La contraseña se puede cambiar desde el propio panel; no vive en variables
// de entorno para no depender de tocar la configuración de Vercel.
model AdminUsuario {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  actualizadoEn DateTime @updatedAt
  creadoEn      DateTime @default(now())
}
