generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts        Account[]
  sessions        Session[]
  progresoModulos ProgresoModulo[]
  resultadoExamen ResultadoExamen?

  // Tope diario de mensajes al asistente virtual (protección de costo).
  asistenteMensajesHoy Int       @default(0)
  asistenteMensajesDia DateTime?

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Resultado del quiz de un módulo para un usuario autenticado.
model ProgresoModulo {
  id         String   @id @default(cuid())
  userId     String
  moduloId   String
  respuestas Json
  aciertos   Int
  total      Int
  porcentaje Int
  aprobado   Boolean
  fecha      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduloId])
}

// Resultado del examen integrador final. Un registro por usuario (se sobrescribe en cada intento).
model ResultadoExamen {
  id         String   @id @default(cuid())
  userId     String   @unique
  respuestas Json
  aciertos   Int
  total      Int
  porcentaje Int
  aprobado   Boolean
  fecha      DateTime @default(now())
  folio      String?  @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
